# Radarr — the only *arr Suggestarr talks to; movies only
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your-radarr-api-key

# TMDB (discovery) — free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key
# TMDB_BASE_URL=https://api.themoviedb.org/3

# Logging: fatal | error | warn | info | debug
SUGGESTARR_LOG_LEVEL=info

# LLM judge: openai | anthropic | ollama | mock
# `mock` is the offline heuristic judge — no key, no network (used by CI/dev)
LLM_PROVIDER=mock
# LLM_API_KEY=your-llm-api-key         # required for openai/anthropic
# LLM_MODEL=claude-opus-5              # per-provider default when unset
# Anthropic only — thinking depth and therefore cost:
# low | medium | high (API default) | xhigh | max
# LLM_EFFORT=medium
# LLM_BASE_URL=http://localhost:11434  # per-provider default when unset
# LLM_TIMEOUT_MS=60000

# Container image (docker compose only) — your GitHub user/org for GHCR
# GHCR_OWNER=your-github-user
# SUGGESTARR_TAG=latest        # or sha-abc1234 to pin a build

# SQLite state (agent decision log, feedback)
SUGGESTARR_DB_PATH=./data/suggestarr.db

# Discord bot (required for `npm run bot`)
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_CHANNEL_ID=channel-to-post-suggestions-in
DISCORD_CLIENT_ID=your-application-id
# DISCORD_GUILD_ID=guild-id   # guild-scoped slash commands register instantly

# Where approved titles land (defaults to the *arr's first root folder/profile)
# RADARR_ROOT_FOLDER=/movies
# RADARR_QUALITY_PROFILE=HD-1080p
# ARR_SEARCH_ON_ADD=true

# Scheduling — the ONLY way a cycle starts (no manual Discord trigger)
SUGGESTARR_SCHEDULE=0 18 * * *
SUGGESTARR_TZ=Europe/Oslo
SUGGESTARR_BATCH_SIZE=10
# Unanswered suggestions expire after this many days. Expiry is not a "no":
# the title returns to the pool and can be suggested again.
SUGGESTARR_EXPIRE_AFTER_DAYS=2
# SUGGESTARR_RUN_ON_START=true   # also run one cycle at boot

# Taste and discovery tuning
# SUGGESTARR_TASTE_NOTES=No horror. Prefer 90s sci-fi and slow-burn crime drama.
# DISCOVERY_MIN_RATING=6
# DISCOVERY_MIN_VOTES=100
# Unreleased films have no votes yet, so the quality floor above is waived
# for them by default. Set false to hold them to it (and lose the source).
# DISCOVERY_EXEMPT_UPCOMING=true
# Batch slots held for unreleased films, out of SUGGESTARR_BATCH_SIZE
# DISCOVERY_UPCOMING_SLOTS=3
# TMDB pages walked per source (20 titles each) — raise if cycles dry up
# DISCOVERY_PAGES=3
# DISCOVERY_YEAR_FROM=1970
# DISCOVERY_INCLUDE_GENRES=878,18
# DISCOVERY_EXCLUDE_GENRES=27
